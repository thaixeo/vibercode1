# =====================================================
# .gitignore - vibercode1
# =====================================================

# ---------- Bảo mật: khóa, mật khẩu, biến môi trường ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
publickey
publickey.pub
secrets/
credentials*.json
service-account*.json

# ---------- Hệ điều hành / file rác ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
._*
.Spotlight-V100
.Trashes
*~
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*

# ---------- Editor / IDE ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
.history/

# ---------- Node / JS ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/cache/
.pnpm-store/

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ---------- Build / output / cache ----------
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.vite/
coverage/
.netlify/
.vercel/
.firebase/
*.log
logs/

# ---------- Video ----------
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv
*.webm
*.m4v
*.mpg
*.mpeg
*.3gp

# ---------- Audio ----------
*.mp3
*.wav
*.flac
*.aac
*.ogg
*.m4a
*.wma
*.aiff

# ---------- File nén / cài đặt / ảnh đĩa ----------
*.zip
*.rar
*.7z
*.tar
*.gz
*.tgz
*.iso
*.dmg
*.exe
*.msi
*.apk

# ---------- File thiết kế / dữ liệu dung lượng lớn ----------
*.psd
*.ai
*.dwg
*.bak.dwg
*.sqlite-journal
*.db-journal
*.mdb
*.accdb

# ---------- Thư mục tạm của Claude / công cụ AI ----------
.claude/settings.local.json
